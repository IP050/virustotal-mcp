{
  "schema_version": 1,
  "claude_code": {
    "plugin_version": "0.1.5",
    "minimum_version": "2.1.283",
    "node_minimum_major": 22,
    "verified_node_majors": [22, 24],
    "install_commands": [
      "claude plugin marketplace add VirusTotal/virustotal-mcp",
      "claude plugin install virustotal@virustotal"
    ],
    "server_url": "https://ai.virustotal.com/mcp",
    "manual_http_command": "claude mcp add --transport http virustotal https://ai.virustotal.com/mcp",
    "guide_url": "https://github.com/VirusTotal/virustotal-mcp/blob/main/docs/claude-code.md"
  },
  "credential_filename_pattern": "^(?:\\.env.*|id_(?:rsa|dsa|ecdsa|ed25519|xmss).*|ssh_host_.*_key.*|\\.netrc|\\.npmrc|\\.pypirc|\\.git-credentials|\\.pgpass|\\.htpasswd|credentials.*|kubeconfig)$|\\.(?:pem|key|kdbx|p12|pfx|ppk|jks|keystore)$"
}
